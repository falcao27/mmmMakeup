# Copie este arquivo para backend/.env e preencha com os dados reais.
# O .env nunca deve ser enviado ao GitHub.

# Supabase (Dashboard > Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave service_role: usada somente no backend, nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# Porta local do backend
PORT=3000

# WhatsApp da loja que recebe os pedidos (DDI + DDD + numero, so digitos)
WHATSAPP_PHONE=5500000000000

# Mercado Pago (Suas integracoes > Credenciais)
MERCADO_PAGO_PUBLIC_KEY=APP_USR-sua-public-key
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-seu-access-token
MERCADO_PAGO_CLIENT_ID=seu-client-id
MERCADO_PAGO_CLIENT_SECRET=seu-client-secret

# OpenAI (opcional): melhoria de fotos de produto no painel admin
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# URLs publicas usadas no retorno do pagamento e no CORS
APP_URL=http://localhost:3000
API_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# Usados apenas por "npm run setup" para criar o primeiro administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=
